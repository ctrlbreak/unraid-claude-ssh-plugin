<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
  <!ENTITY name      "claude-ssh">
  <!ENTITY author    "Patrick">
  <!ENTITY version   "2026.05.06b">
  <!ENTITY pluginURL "/boot/config/plugins/&name;/&name;.plg">
  <!ENTITY pkgURL    "/boot/config/plugins/&name;/&name;.txz">
  <!ENTITY cfgDir    "/boot/config/plugins/&name;">
  <!ENTITY emhttpDir "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;">

<CHANGES>
###2026.05.06b
- Settings UI: Allowlist editor on the Settings/Status tab. Two textareas for
  plugin and container names, Save and Reload buttons, status pane.
  Server-side validation against the same name regex used by the filter and
  writer. Atomic write to allowlist.cfg via temp-file plus rename. Header
  comment block is regenerated on every save (manual edits to comments and
  unrelated lines are not preserved through the UI).
- exec.php: new load_allowlist and save_allowlist routes; helper functions
  load_allowlist_file and save_allowlist_file are also callable directly
  from PHP CLI for tests (dispatcher early-returns under cli SAPI).
- Tests: new test-settings-save.sh exercises the save/load round-trip with
  a 35-case sandbox suite (skips if php is not installed).
  test-claude-write-validation.sh extended to assert exec.php uses the same
  allowlist path default, env-var override, and name regex as the shell side.

###2026.05.06a
- Filter v9 + writer v4: hook-sonarr/hook-radarr categories collapsed into
  a generic appdata-script category. New 3-arg form: container name plus
  basename, target /mnt/user/appdata/CONTAINER/scripts/. Container
  allowlist added to allowlist.cfg as "container NAME" lines (same parser
  and name regex as the plugin allowlist; default-deny when empty).
  Allowlist parser is now parametric on line-prefix; filter and writer
  both reuse it.
- BREAKING: hook-sonarr / hook-radarr no longer accepted. Migrate to
  "appdata-script sonarr" / "appdata-script radarr" and add the matching
  "container" lines to allowlist.cfg.
- exec.php counters: dropped hook-sonarr/hook-radarr rows; added appdata-script.
- install-runtime.sh seed template extended with container examples.

###2026.05.06
- Filter v8 + writer v3: plugin-name allowlist moved to runtime config at
  /boot/config/plugins/claude-ssh/allowlist.cfg. Default-deny when empty.
- install-runtime.sh seeds a commented-template allowlist.cfg on first install
  (existing files never overwritten).
- New tests: test-allowlist-config.sh (parser behaviour) +
  test-boot-config-write-block.sh (filter blocks writes to /boot/config/).

###2026.05.04
- Initial release: packages claude SSH filter v7 + claude-write writer v2
- Single-tab Status page with collapsible Audit Log section
- Dashboard tile showing filter version + 24h activity
- Filter v7: plugin-name parameterised plugin-* categories, new scratch category
- Idempotent install/upgrade — re-runs setup scripts, single /boot/config/go entry
- Non-destructive uninstall — preserves /home/claude/, backups, user account
</CHANGES>

<!--
Install / upgrade script. The .txz extracts the plugin tree to
/usr/local/emhttp/plugins/claude-ssh/, then install-runtime.sh runs the
filter + writer setup scripts and registers the boot hook.
-->
<FILE Run="/bin/bash">
<INLINE>
#!/bin/bash

PLUGIN="claude-ssh"
CFG_DIR="/boot/config/plugins/${PLUGIN}"

echo "Installing ${PLUGIN}..."

# Create config directory on flash (preserves user state across upgrades)
mkdir -p "${CFG_DIR}"

# Install or upgrade the package. --reinstall ensures all files in the .txz
# overwrite the previous version cleanly (without it, identical paths from
# older versions can stick around).
upgradepkg --install-new --reinstall "&pkgURL;"

# Run the runtime installer: deploys the SSH filter + claude-write writer
# and registers the boot hook in /boot/config/go.
bash "&emhttpDir;/scripts/install-runtime.sh"

echo "${PLUGIN} installed."
</INLINE>
</FILE>

<!--
Remove script. Non-destructive: tears down runtime artifacts (sudoers, sshd
config additions, claude-write binaries, /boot/config/go hook) but leaves
/home/claude/, the claude user, and the backup directory intact.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#!/bin/bash

PLUGIN="claude-ssh"
echo "Removing ${PLUGIN}..."

# Run uninstall-runtime.sh BEFORE removepkg — needs the script to exist.
if [ -x "/usr/local/emhttp/plugins/${PLUGIN}/scripts/uninstall-runtime.sh" ]; then
    bash "/usr/local/emhttp/plugins/${PLUGIN}/scripts/uninstall-runtime.sh"
fi

# Remove the package. Config dir on flash is preserved.
removepkg "${PLUGIN}"

echo "${PLUGIN} removed. Config preserved at /boot/config/plugins/${PLUGIN}/"
echo "To fully purge: userdel claude &amp;&amp; rm -rf /home/claude /mnt/cache/appdata/claude-write-backups"
</INLINE>
</FILE>

<!--
Package file (pre-built .txz placed alongside .plg on flash)
-->
<FILE Name="&pkgURL;">
<URL>&pkgURL;</URL>
</FILE>

</PLUGIN>

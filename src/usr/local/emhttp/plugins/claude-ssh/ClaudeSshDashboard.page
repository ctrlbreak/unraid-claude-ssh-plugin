<script>
(function() {
  var pluginName = 'claude-ssh';

  function setText(id, text) {
    var el = document.getElementById(id);
    if (el) el.textContent = text;
  }
  function setBadge(id, ok) {
    var el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('cs-ok', 'cs-bad');
    el.classList.add(ok ? 'cs-ok' : 'cs-bad');
  }
  function setDot(color) {
    var el = document.getElementById('cs-tile-dot');
    if (!el) return;
    el.classList.remove('cs-tile-green', 'cs-tile-amber', 'cs-tile-red', 'cs-tile-grey');
    el.classList.add('cs-tile-' + (color || 'grey'));
  }

  function load() {
    $.post('/plugins/' + pluginName + '/include/exec.php', { action: 'dashboard' }, function(data) {
      if (!data) return;

      setDot(data.color);
      var verdict = data.healthy
        ? (data.color === 'amber' ? 'Healthy · activity blocked' : 'Healthy')
        : 'Not installed';
      setText('cs-tile-verdict', verdict);
      setText('cs-tile-plugin-ver', data.plugin_version ? 'Plugin ' + data.plugin_version : '');

      var h = data.health || {};
      setText('cs-tile-user',         data.username || '?');
      setText('cs-tile-filter-ver',   data.filter_version || '?');
      setText('cs-tile-writer-ver',   data.writer_version || '?');
      var keys = (h.ssh_key_count != null ? h.ssh_key_count : 0);
      setText('cs-tile-keys',         keys);
      setText('cs-tile-keys-label',   keys === 1 ? 'SSH key' : 'SSH keys');
      setBadge('cs-tile-b-user',    !!h.user_exists);
      setBadge('cs-tile-b-filter',  !!h.filter_installed);
      setBadge('cs-tile-b-writer',  !!h.writer_installed);
      setBadge('cs-tile-b-sudoers', !!h.sudoers_installed);
      setBadge('cs-tile-b-keys',    keys > 0);

      var a = data.activity_24h || {};
      setText('cs-tile-accepted', (a.accepted != null ? a.accepted : 0));
      setText('cs-tile-blocked',  (a.blocked  != null ? a.blocked  : 0));
      setText('cs-tile-writes',   (a.writes   != null ? a.writes   : 0));
      setText('cs-tile-rejected', (a.rejected != null ? a.rejected : 0));

      var al = data.allowlist || {};
      setText('cs-tile-allow-plugins',    (al.plugins    != null ? al.plugins    : 0));
      setText('cs-tile-allow-containers', (al.containers != null ? al.containers : 0));
    }, 'json');
  }

  $(function() {
    load();
    setInterval(load, 60000);
  });
})();
</script>

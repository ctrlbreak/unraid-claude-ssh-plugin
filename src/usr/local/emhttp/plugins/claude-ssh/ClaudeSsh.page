  letter-spacing: 0.3px;
}
.cs-pill-green { background: #27ae60; }
.cs-pill-amber { background: #f39c12; }
.cs-pill-red   { background: #e74c3c; }
.cs-pill-grey  { background: #95a5a6; }

table.cs-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.92em;
}
table.cs-table th, table.cs-table td {
  padding: 6px 10px;
  border-bottom: 1px solid var(--border, #eee);
  text-align: left;
}

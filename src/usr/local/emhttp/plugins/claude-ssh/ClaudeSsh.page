.cs-kpi-value { font-size: 1.4em; font-weight: bold; margin-top: 4px; }
.cs-kpi-green  { border-left-color: #27ae60; color: #27ae60; }
.cs-kpi-amber  { border-left-color: #f39c12; color: #f39c12; }
